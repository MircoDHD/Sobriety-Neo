<?xml version="1.0" encoding="utf-8"?>
<!--
  One key number tile on the Statistics screen: a big value ("3 mo 2 w") and a small label below.
  Uses the card colors of the theme, so it matches the tracker cards in light, dark and AMOLED.
  The margins are set on the <include> tags in activity_statistics.xml.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/cardColor"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tile_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?attr/colorTextOnCard"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorTextOnCard"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

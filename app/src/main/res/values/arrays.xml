        <item>@string/mode_counter</item>
        <item>@string/mode_milestone</item>
        <item>@string/mode_both</item>
    </string-array>
    <!-- index 0 = no limit, index n = n units -->
    <string-array name="max_units">
        <item>@string/max_units_all</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
        <item>5</item>
        <item>6</item>
    </string-array>
    <string-array name="time_unit_levels">

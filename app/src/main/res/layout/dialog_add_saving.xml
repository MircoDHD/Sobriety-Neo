<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom sheet for adding or editing a saving (Savings screen).
  Sobriety Neo: a category (money / other) and the period of the amount (per day, week or month)
  were added. Money savings are added up and shown on the main screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name_str"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="48dp"
                android:text="@string/saving_name"
                android:textStyle="bold"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/btn_info"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/ripple"
                android:src="@drawable/info_24px"
                android:contentDescription="@string/info"
                android:tooltipText="@string/info" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/savings_name_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_new_saving_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/savings_name_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category: money or something else -->
        <com.google.android.material.textfield.TextInputLayout
            style="?attr/textInputOutlinedExposedDropdownMenuStyle"
            android:id="@+id/savings_category_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/saving_category">
            <AutoCompleteTextView
                android:id="@+id/savings_category_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                app:simpleItems="@array/saving_categories" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Amount and the period it is for -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/savings_amount_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:hint="@string/amount_saved_short">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/savings_amount_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedExposedDropdownMenuStyle"
                android:id="@+id/savings_period_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="@string/saving_period">
                <AutoCompleteTextView
                    android:id="@+id/savings_period_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    app:simpleItems="@array/rate_periods" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Currency (money) or unit (other) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/unit_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/unit">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/unit_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_save_saving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:text="@string/save"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</ScrollView>

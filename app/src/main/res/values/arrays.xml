    <!-- Sobriety Neo. saving_categories: order is used in Savings.kt / SavingsAdapter.kt.
         rate_periods, counter_modes, time_unit_levels: order must match the enums
         RatePeriod, CounterMode and TimeUnitLevel in the shared module. -->
    <string-array name="saving_categories">
        <item>@string/saving_category_money</item>
        <item>@string/saving_category_time</item>
        <item>@string/saving_category_other</item>
    </string-array>

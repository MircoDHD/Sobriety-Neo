<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/appearance"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="theme"
            app:title="@string/theme"
            app:entryValues="@array/theme_entry_values"
            app:entries="@array/theme_entries"
            app:defaultValue="system"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>

        <SwitchPreferenceCompat
            app:key="material_you"
            app:title="@string/material_you"
            app:summary="@string/material_you_subtext"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

        <!-- Sobriety Neo, new UI only (removed in the classic variant, see Settings.kt) -->
        <SwitchPreferenceCompat
            app:key="amoled_black"
            app:title="@string/amoled_black"
            app:summary="@string/amoled_black_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <!-- Sobriety Neo, new UI only: tabs and order of the cards -->
    <PreferenceCategory
        app:key="category_layout"
        app:title="@string/layout"
        app:iconSpaceReserved="false">

        <Preference
            app:key="manage_tabs"
            app:persistent="false"
            app:title="@string/manage_tabs"
            app:summary="@string/manage_tabs_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="show_all_tab"
            app:title="@string/show_all_tab"
            app:summary="@string/show_all_tab_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>

        <ListPreference
            app:key="card_sort"
            app:title="@string/card_sort"
            app:entries="@array/card_sort_entries"
            app:entryValues="@array/card_sort_values"
            app:defaultValue="priority"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/general"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="date_format"
            app:title="@string/date_format"
            app:entryValues="@array/date_format_patterns"
            app:defaultValue="MMMM dd uuuu"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            app:key="add_note_after_relapse"
            app:title="@string/add_note_after_relapse_pref"
            app:summary="@string/add_note_after_relapse_pref_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="average_attempts_window"
            app:title="@string/average_attempts_window_pref"
            app:defaultValue="3"
            app:useSimpleSummaryProvider="true"

            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/timeline"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="alt_timeline_view"
            app:title="@string/use_alt_timeline_view"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/daily_notes"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="sort_notes"
            app:title="@string/sort_order"
            app:entries="@array/sort_entries"
            app:entryValues="@array/sort_entry_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            app:defaultValue="asc"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/milestones"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="sort_milestones"
            app:title="@string/sort_order"
            app:entries="@array/sort_entries"
            app:entryValues="@array/sort_entry_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            app:defaultValue="asc"/>

        <SwitchPreferenceCompat
            app:key="hide_completed_milestones"
            app:title="@string/hide_completed_milestones"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

        <!-- Sobriety Neo: default milestones for new entries (opt-out), see DefaultMilestones.kt -->
        <SwitchPreferenceCompat
            app:key="default_milestones_enabled"
            app:title="@string/default_milestones"
            app:summary="@string/default_milestones_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="edit_default_milestones"
            app:persistent="false"
            app:title="@string/edit_default_milestones"
            app:dependency="default_milestones_enabled"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="apply_default_milestones"
            app:persistent="false"
            app:title="@string/apply_default_milestones"
            app:summary="@string/apply_default_milestones_summary"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/data"
        app:iconSpaceReserved="false">

        <Preference
            app:key="data_export"
            app:title="@string/data_export"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="data_import"
            app:title="@string/data_import"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Sobriety Neo: optional, anonymous diagnostics log (see utils/DiagnosticsLog.kt). -->
    <PreferenceCategory app:title="@string/diagnostics"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="diagnostics_enabled"
            app:title="@string/diagnostics_enabled"
            app:summary="@string/diagnostics_enabled_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="diagnostics_info"
            app:persistent="false"
            app:title="@string/diagnostics_what"
            app:icon="@drawable/info_24px" />

        <Preference
            app:key="diagnostics_export"
            app:persistent="false"
            app:title="@string/diagnostics_export"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="diagnostics_delete"
            app:persistent="false"
            app:title="@string/diagnostics_delete"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/about"
        app:iconSpaceReserved="false">

        <Preference
            app:key="pref_app_version"
            app:persistent="false"
            app:title="@string/version"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="pref_app_issue_tracker"
            app:persistent="false"
            app:title="@string/report_an_issue"
            app:summary="@string/opens_issue_tracker"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="pref_app_license"
            app:persistent="false"
            app:title="@string/license"
            app:summary="@string/app_license"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>